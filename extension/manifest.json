{
  "manifest_version": 3,
  "name": "pdfpal Kindle Companion",
  "description": "Read Kindle with local passage capture, pdfpal AI chat, and project notes.",
  "version": "0.5.0",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/favicon-16.png",
    "32": "icons/favicon-32.png",
    "192": "icons/icon-192.png",
    "512": "icons/icon-512.png"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://read.amazon.com/*",
    "https://ler.amazon.com.br/*",
    "https://read.amazon.co.uk/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_title": "Open pdfpal Kindle Companion",
    "default_icon": {
      "16": "icons/favicon-16.png",
      "32": "icons/favicon-32.png",
      "192": "icons/icon-192.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://read.amazon.com/*",
        "https://ler.amazon.com.br/*",
        "https://read.amazon.co.uk/*"
      ],
      "js": [
        "capture.js"
      ],
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self' http://127.0.0.1:* http://localhost:*; object-src 'none'"
  },
  "key": ""
}
