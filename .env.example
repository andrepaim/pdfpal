# AI chat — which coding-agent CLI to use for chat (claude | codex | opencode)
PDFPAL_AGENT=claude

# Path to the claude CLI binary (used when PDFPAL_AGENT=claude)
CLAUDE_BIN=/usr/local/bin/claude

# Codex CLI binary (used when PDFPAL_AGENT=codex). Default: codex
# CODEX_BIN=codex

# opencode CLI binary (used when PDFPAL_AGENT=opencode). Default: opencode
# OPENCODE_BIN=opencode

# Optional model override passed to codex/opencode (e.g. gpt-5.4, anthropic/claude-sonnet-4)
# PDFPAL_MODEL=

# Optional web search augmentation
TAVILY_API_KEY=

# Local data overrides (defaults: ~/.pdfpal and ~/.pdfpal/pdfpal.db)
# PDFPAL_DATA_DIR=/path/to/data
# PDFPAL_DB=/path/to/pdfpal.db
# PDFPAL_PORT=8200
